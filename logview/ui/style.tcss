Screen {
    layout: vertical;
}

FilterBar {
    height: 3;
    dock: top;
    background: $panel;
    padding: 0 1;
    align-vertical: middle;
}

FilterBar Label {
    padding: 0 1;
    margin-top: 1;
}

FilterBar Select {
    width: 20;
}

FilterBar Input {
    width: 1fr;
}

StatusBar {
    height: 1;
    dock: bottom;
    background: $accent;
    color: $text;
    padding: 0 1;
}

SearchBar {
    height: 3;
    dock: bottom;
    background: $panel;
    padding: 0 1;
    display: none;
    align-vertical: middle;
}

SearchBar Label {
    padding: 0 1;
    margin-top: 1;
}

SearchBar Input {
    width: 1fr;
}

#search_results_label {
    min-width: 10;
}

RichLog {
    height: 1fr;
    background: $surface;
}

/* We will handle highlighting via rich text in the app. */

#save_dialog {
    padding: 1 2;
    width: 50;
    height: 15;
    border: thick $background 80%;
    background: $surface;
    align: center middle;
}

#save_prompt {
    margin-bottom: 1;
}

#save_buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#save_buttons Button {
    margin: 0 1;
}
