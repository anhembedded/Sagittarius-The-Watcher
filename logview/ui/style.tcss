Screen {
    layout: vertical;
}

FilterBar {
    height: 3;
    dock: top;
    background: $panel;
    border: ascii $background 50%;
    padding: 0 1;
    align-vertical: middle;
}

FilterBar Label {
    padding: 0 1;
    margin-top: 1;
}

FilterBar Select {
    width: 20;
}

FilterBar Input {
    width: 1fr;
}

FilterBar Input.-error {
    border: tall $error;
}

StatusBar {
    height: 1;
    dock: bottom;
    background: $accent;
    color: $text;
    padding: 0 1;
}

#status_label {
    text-style: bold;
}

#stats_label {
    color: $text-muted;
}

SearchBar {
    height: 3;
    dock: bottom;
    background: $panel;
    padding: 0 1;
    display: none;
    align-vertical: middle;
}

SearchBar Label {
    padding: 0 1;
    margin-top: 1;
}

SearchBar Input {
    width: 1fr;
}

#search_results_label {
    min-width: 10;
}

CustomLogList {
    height: 1fr;
    background: $surface;
}

/* We will handle highlighting via rich text in the app. */

HelpScreen {
    align: center middle;
    background: $background 50%;
}

#help_dialog {
    padding: 1 2;
    width: 60;
    height: auto;
    border: thick $background 80%;
    background: $surface;
}

#help_title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
    width: 100%;
}

#save_dialog {
    padding: 1 2;
    width: 50;
    height: 15;
    border: thick $background 80%;
    background: $surface;
    align: center middle;
}

#save_prompt {
    margin-bottom: 1;
}

#save_buttons {
    margin-top: 1;
    align: center middle;
    height: 3;
}

#save_buttons Button {
    margin: 0 1;
}
